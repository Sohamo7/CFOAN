{
  "manifest_version": 3,
  "name": "AI Executive Assistant",
  "version": "1.0",
  "description": "Reads Gmail and drafts calendar meetings using AI.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["https://mail.google.com/*"]
}